# Copie para .env (ignorado pelo git). Em dev o Spring lê este arquivo automaticamente
# (spring.config.import); em produção, defina as variáveis no ambiente do processo/container.
SERVER_PORT=8080

# Auth0: domínio sem https:// e o Identifier da API cadastrada no Auth0.
AUTH0_DOMAIN=dev-slbrfj6dwk1pdeox.us.auth0.com
AUTH0_AUDIENCE=https://erp-banking-api
# Origens do frontend, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Credit Score API (o token do usuário é repassado nas chamadas).
CREDIT_SCORE_API_URL=http://localhost:8082
ONBOARDING_API_URL=http://localhost:8081

# Banco: H2 em memória por padrão. Para PostgreSQL:
# DATABASE_URL=jdbc:postgresql://localhost:5432/erp?currentSchema=transactions
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_DRIVER=org.postgresql.Driver

# RabbitMQ (exchange erp.events). Vazio = mensageria desligada (no-op), bom para dev e testes.
# RABBITMQ_URL=amqp://erp:erp@localhost:5672/
# MESSAGING_ENABLED=true
# Abre conta corrente ao consumir customer.created (fila transactions.customer-created).
# AUTO_OPEN_ACCOUNT=true
